# Virtual environment
.venv/
venv/
ENV/

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Data (Never commit raw or processed datasets to Git)
data/*
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/processed/
data/processed/*
!data/processed/.gitkeep

# Models (Heavy binary artifacts)
models/*
!models/.gitkeep

# IDE & OS
.DS_Store
.vscode/
.idea/

# Environment secrets
.env
